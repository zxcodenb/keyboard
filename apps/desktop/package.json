{
  "name": "keyboard-light-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CGO_ENABLED=1 go run github.com/egoist/mygo/cmd/mygo dev",
    "build": "CGO_ENABLED=1 go run github.com/egoist/mygo/cmd/mygo build -skip-dmg",
    "generate": "CGO_ENABLED=1 go run github.com/egoist/mygo/cmd/mygo generate",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "tsc --noEmit -p frontend/tsconfig.json && vite build",
    "test": "CGO_ENABLED=1 go test ../../... && tsc --noEmit -p frontend/tsconfig.json && playwright test"
  },
  "dependencies": { "mygo-runtime": "0.3.6", "lucide": "^0.577.0" },
  "devDependencies": { "@playwright/test": "^1.58.2", "typescript": "^5.9.3", "vite": "^8.0.0" }
}
